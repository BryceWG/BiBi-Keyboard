    <!-- 流式识别 - Streaming recognition -->
    <string name="feature_dash_streaming_off_desc">使用非流式识别。录音结束后开始处理，可能有延迟。可用于 Qwen-Audio-3.0-ASR-Flash、Fun-ASR-Flash 与 Qwen3.5/3.8-Omni 系列模型。</string>
    <string name="feature_dash_streaming_on_desc">使用流式识别。边说话边实时显示转写结果。默认使用 Qwen-Audio-3.0-ASR-Flash-Streaming；也可在下方切换 Fun-ASR-Realtime。</string>

    <!-- Fun-ASR 模型（仅流式） -->
    <string name="feature_dash_fun_asr_off_desc">流式识别使用 Qwen-Audio-3.0-ASR-Flash-Streaming（默认）。</string>
    <string name="feature_dash_fun_asr_on_desc">流式识别使用 Fun-ASR-Realtime。</string>

    <!-- DashScope 语义断句 -->
    <string name="feature_dash_semantic_punct_off_desc">主要根据说话停顿断句，通常返回更快。</string>
    <string name="feature_dash_semantic_punct_on_desc">结合语句含义判断断句，标点可能更自然，但返回可能稍慢。</string>
