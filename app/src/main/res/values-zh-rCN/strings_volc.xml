    <!-- ============================================== -->
    <!-- 火山引擎 ASR - 功能说明 -->
    <!-- Feature Explanations for Volcengine ASR -->
    <!-- ============================================== -->

    <!-- 流式识别 - Streaming recognition -->
    <string name="feature_volc_streaming_off_desc">请在「识别模型」中选择普通文件或极速文件识别。录音结束后上传完整音频。</string>
    <string name="feature_volc_streaming_on_desc">该模式已由「识别模型」中的流式语音识别 1.0 或 2.0 表达。边说边出字，需要较稳定的网络。</string>

    <!-- 语义顺滑 - Semantic smoothing -->
    <string name="feature_volc_ddc_off_desc">输出原始识别结果，不做额外处理。</string>
    <string name="feature_volc_ddc_on_desc">启用语义顺滑，自动优化识别结果的表达和格式。实验性功能。</string>

    <!-- VAD 分句 - VAD sentence segmentation -->
    <string name="feature_volc_vad_off_desc">整段录音会连续识别，不根据说话和停顿自动分段。</string>
    <string name="feature_volc_vad_on_desc">会根据说话和停顿自动分段，长录音可能更容易阅读；实际效果取决于音频和服务端。</string>

    <!-- 二遍识别 - Non-streaming optimization -->
    <string name="feature_volc_nonstream_off_desc">只使用流式识别的第一遍结果，文字返回更直接，但不会再进行二次修正。</string>
    <string name="feature_volc_nonstream_on_desc">服务端会对流式识别结果再进行一次修正，最终文字可能更准确，但中间结果可能发生变化。</string>

  <!-- 文件识别普通版 - File recognition (standard mode) -->
    <string name="feature_volc_file_standard_off_desc">请在「识别模型」中选择极速文件识别 1.0。录音结束后上传，速度更快。</string>
    <string name="feature_volc_file_standard_on_desc">请在「识别模型」中选择普通文件识别 1.0 或 2.0。录音结束后上传完整音频（提交/查询），准确度更好。</string>

    <!-- 模型版本 - Model version -->
    <string name="feature_volc_model_v2_off_desc">请在「识别模型」中选择对应的 1.0 模型。</string>
    <string name="feature_volc_model_v2_on_desc">请在「识别模型」中选择对应的 2.0 模型。准确度更好，支持更多语言。</string>

    <!-- 新鉴权方式 - New auth -->
    <string name="feature_volc_use_new_auth_off_desc">使用经典的 App Key / Access Key 鉴权方式。</string>
    <string name="feature_volc_use_new_auth_on_desc">使用较新的 X-Api-Key 鉴权方式。请选择与火山引擎控制台凭证一致的方式。</string>
