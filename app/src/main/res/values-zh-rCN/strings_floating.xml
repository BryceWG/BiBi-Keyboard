    <!-- ============================================== -->
    <!-- 悬浮球设置 - 功能说明 -->
    <!-- ============================================== -->

    <!-- 使用悬浮球进行语音识别 -->
    <string name="feature_floating_asr_off_desc">不显示悬浮球，仍可从说点啥键盘使用语音输入。</string>
    <string name="feature_floating_asr_on_desc">在其他应用上方显示语音输入悬浮球，即使键盘未显示也可开始识别。需要悬浮窗权限；音量键控制和部分文字输入方式还需要无障碍服务或输入法桥接。</string>

    <!-- 仅在键盘显示时显示悬浮球 -->
    <string name="feature_floating_only_when_ime_visible_off_desc">即使键盘隐藏，悬浮球仍保持可见。</string>
    <string name="feature_floating_only_when_ime_visible_on_desc">键盘隐藏时悬浮球自动隐藏，键盘出现时自动显示。键盘状态可通过无障碍或已激活的输入法桥接检测。</string>

    <!-- 长按悬浮球录音 -->
    <string name="feature_floating_hold_to_record_off_desc">点按悬浮球开始录音，再次点按停止录音。</string>
    <string name="feature_floating_hold_to_record_on_desc">长按悬浮球开始录音，松手停止。滑出菜单或移动悬浮球需要拖动更长距离，触发时会取消本轮录音。</string>

    <!-- 直接拖动移动悬浮球 -->
    <string name="feature_floating_direct_drag_off_desc">移动悬浮球需要长按进入移动模式或通过菜单开启移动模式。</string>
    <string name="feature_floating_direct_drag_on_desc">可直接拖动悬浮球调整位置。</string>

    <!-- 音量键录音模式 -->
    <string name="feature_volume_key_recording_off_desc">音量键保持系统默认行为，不用于控制录音。</string>
    <string name="feature_volume_key_recording_on_desc">当键盘显示时，无障碍服务会监听音量键点击，用于开始或停止语音识别。不监听不稳定的音量键长按。</string>
    <string name="feature_volume_key_status_toast_off_desc">音量键录音开始和停止时不额外提示，现有错误提示不受影响。</string>
    <string name="feature_volume_key_status_toast_on_desc">使用音量键成功开始或停止录音时，显示短 Toast 提示。</string>
    <string name="feature_volume_key_stop_on_ime_hidden_off_desc">音量键录音期间如果键盘消失，录音会继续，直到你手动停止。</string>
    <string name="feature_volume_key_stop_on_ime_hidden_on_desc">音量键录音期间如果键盘消失，会自动停止录音。</string>

    <!-- 悬浮球写入文字兼容性模式 -->
    <string name="feature_floating_ime_bridge_off_desc">停止接受所有 Hook 联动请求；主键盘与悬浮球的非 Hook 功能不受影响。</string>
    <string name="feature_floating_ime_bridge_on_desc">在客户端侧启用兼容 LSPosed/LSPatch 模块提供的输入法可见性、文字插入、录音和剪贴板能力，不影响模块自身设置和状态。</string>
    <string name="feature_ime_bridge_pcm_recording_off_desc">桥接模块仍可输入识别结果，但无法在第三方键盘中长按录音。</string>
    <string name="feature_ime_bridge_pcm_recording_on_desc">可在兼容的第三方键盘中长按录音，并将录音交给说点啥识别。录音失败时不会自动改用悬浮球或本应用的麦克风。</string>
    <string name="feature_floating_a11y_android13_api_off_desc">识别结果通过传统无障碍 API 写入，并保留流式预览，与兼容优化功能配合，适用于一般应用和旧系统。</string>
    <string name="feature_floating_a11y_android13_api_on_desc">在 Android 13 及以上优先通过新的无障碍 API 插入识别结果，在终端、编辑器等特殊场景有更好的表现。写入文字兼容优化功能自动失效，但会关闭流式预览功能。</string>
    <string name="feature_floating_write_compat_off_desc">识别结果会直接写入输入框，适用于大多数应用。</string>
    <string name="feature_floating_write_compat_on_desc">在你指定的兼容应用中，会先选中输入框内容，再通过粘贴写入识别结果，以避免混入提示文字。期间会暂时使用剪贴板，并在完成后尝试恢复原内容。</string>

    <!-- 悬浮球识别结果仅写入粘贴板 -->
    <string name="feature_floating_write_paste_off_desc">识别结果会自动输入到当前输入框。</string>
    <string name="feature_floating_write_paste_on_desc">在你指定的应用中，识别结果只会复制到剪贴板，不会自动输入；你需要在输入框中手动粘贴。</string>

    <!-- 前台保活 -->
    <string name="feature_floating_keep_alive_off_desc">应用在后台运行一段时间后更容易被系统停止，悬浮球和音量键功能可能因此失效。</string>
    <string name="feature_floating_keep_alive_on_desc">显示一条常驻通知，帮助悬浮球和音量键功能在后台持续可用。部分手机仍需调整电池设置。</string>
    <string name="feature_floating_keep_alive_privileged_off_desc">只使用普通方式维持后台运行，部分手机可能仍会停止悬浮球或音量键功能。</string>
    <string name="feature_floating_keep_alive_privileged_on_desc">使用 Shizuku 或 root 定期恢复后台服务，减少悬浮球或音量键功能失效。需要先授予 Shizuku 权限或 root 权限。</string>
</resources>
