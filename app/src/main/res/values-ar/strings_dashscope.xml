    <!-- DashScope - Streaming -->
    <string name="feature_dash_streaming_off_desc">يستخدم تعرّفاً غير متدفق. تبدأ المعالجة بعد انتهاء التسجيل وقد يحدث تأخير. متاح لنماذج Qwen-Audio-3.0-ASR-Flash وFun-ASR-Flash وQwen3.5/3.8-Omni.</string>
    <string name="feature_dash_streaming_on_desc">يستخدم التعرّف بالبث. تُعرض نتائج النسخ النصي فوراً أثناء الكلام. الافتراضي Qwen-Audio-3.0-ASR-Flash-Streaming؛ يمكنك التبديل إلى Fun-ASR-Realtime أدناه.</string>

    <!-- DashScope - Fun-ASR model (streaming) -->
    <string name="feature_dash_fun_asr_off_desc">يستخدم Qwen-Audio-3.0-ASR-Flash-Streaming للبث (افتراضي).</string>
    <string name="feature_dash_fun_asr_on_desc">يستخدم Fun-ASR-Realtime للبث.</string>

    <!-- DashScope - Semantic Segmentation -->
