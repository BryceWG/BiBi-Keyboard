  <!-- Feature Descriptions for Input Settings -->
  <!-- ============================================== -->
  <!-- Trim trailing punctuation -->
  <string name="feature_trim_trailing_punct_off_desc">ستحتفظ نتائج التعرّف بكل المحتوى كما هو.</string>
  <string name="feature_trim_trailing_punct_on_desc">نتائج التعرّف ضمن العتبة ستُزيل الترقيم والإيموجي الختامي. عيّن العتبة إلى بدون حد لتطبيقها على أي طول.</string>

  <!-- Mic haptic -->
  <string name="feature_mic_haptic_off_desc">لا اهتزاز عند الضغط على المفاتيح أو التفاعل مع الكرة العائمة.</string>
  <string name="feature_mic_haptic_on_desc">يوفر اهتزازاً عند الضغط على المفاتيح أو التفاعل مع الكرة العائمة لتجربة لمس أفضل.</string>

  <!-- Mic tap toggle -->
  <string name="feature_mic_tap_toggle_off_desc">اضغط مطوّلاً على زر الميكروفون للتسجيل، أفلت للإيقاف.</string>
  <string name="feature_mic_tap_toggle_on_desc">اضغط زر الميكروفون لبدء التسجيل، واضغط مجدداً للإيقاف. أسهل بيد واحدة.</string>

  <!-- Auto start recording on show -->
  <string name="feature_auto_start_recording_on_show_off_desc">تحتاج للضغط يدوياً على الميكروفون لبدء التسجيل بعد ظهور اللوحة.</string>
  <string name="feature_auto_start_recording_on_show_on_desc">يبدأ التسجيل تلقائياً عند ظهور اللوحة، لتوفير ضغطة.</string>
  <string name="feature_continuous_capture_off_desc">لا يستمر التسجيل أثناء ظهور اللوحة أو الكرة العائمة؛ يبدأ فقط بعد الضغط على الميكروفون.</string>
  <string name="feature_continuous_capture_on_desc">أثناء ظهور اللوحة أو الكرة العائمة، يُسجَّل الصوت محلياً في الخلفية ليبدأ التعرّف أسرع عند الضغط على الميكروفون. لا يُرفع الصوت حتى تبدأ التعرّف.</string>
  <string name="feature_keep_screen_on_while_recording_off_desc">عند الإيقاف، يمكن أن تنطفئ الشاشة أثناء التسجيل وفق مهلة النظام.</string>
  <string name="feature_keep_screen_on_while_recording_on_desc">أثناء التسجيل عبر لوحة المفاتيح أو الكرة العائمة، تبقى الشاشة مضاءة حتى لا تنام في منتصف التسجيل.</string>

  <!-- Auto enter after input -->
  <string name="feature_auto_enter_after_asr_off_desc">بعد التعرّف (ومعالجة الذكاء الاصطناعي إن فُعّلت)، يُدرج النص فقط. يمكنك السحب يميناً على الميكروفون للإرسال بـ Enter في تلك الجلسة.</string>
  <string name="feature_auto_enter_after_asr_on_desc">بعد اكتمال التعرّف—بما فيه معالجة الذكاء الاصطناعي عند التفعيل—يُضغط Enter / إجراء الإرسال تلقائياً لإرسال الرسالة في تطبيقات الدردشة. تُتخطّى النتائج الفارغة.</string>

  <!-- Auto switch IME after input -->
  <string name="feature_auto_switch_ime_after_asr_off_desc">بعد اكتمال الإدخال تبقى طريقة الإدخال الحالية. لا يتم التبديل تلقائياً.</string>
  <string name="feature_auto_switch_ime_after_asr_on_desc">بعد انتهاء المعالجة اللاحقة وتثبيت نص المعاينة، يتم التبديل تلقائياً إلى طريقة الإدخال المحددة في «طريقة الإدخال المستهدفة» لمتابعة التحرير. إن لم تُضبط تُستخدم السابقة. تُتخطّى النتائج الفارغة.</string>

  <!-- Fcitx5 return on switcher -->
  <string name="feature_fcitx5_return_on_switcher_off_desc">مفتاح تبديل IME يفتح منتقي طرق الإدخال بالنظام.</string>
  <string name="feature_fcitx5_return_on_switcher_on_desc">مفتاح تبديل IME يعود لطريقة الإدخال المحددة (يعود للسابقة إن لم تُضبط).</string>

  <!-- Return prev IME on hide -->
  <string name="feature_return_prev_ime_on_hide_off_desc">تبقى طريقة الإدخال الحالية BiBi Keyboard بعد الإخفاء.</string>
  <string name="feature_return_prev_ime_on_hide_on_desc">يتبدل إلى طريقة الإدخال المحددة عند إخفاء اللوحة (يعود للسابقة إن لم تُضبط)، مناسب للإدخال الصوتي المؤقت.</string>

  <!-- Hide recent tasks -->
  <string name="feature_hide_recent_tasks_off_desc">بطاقة التطبيق ظاهرة في نظرة المهام الأخيرة.</string>
  <string name="feature_hide_recent_tasks_on_desc">تُخفى بطاقة التطبيق من المهام الأخيرة لواجهة أنظف. قد يقلّل من قدرة إبقاء التطبيق في الخلفية.</string>

  <!-- Duck media on record -->
  <string name="feature_duck_media_on_record_off_desc">لا يطلب التطبيق من التطبيقات الأخرى خفض الصوت أو الإيقاف أثناء التسجيل، فقد يلتقط الميكروفون صوت الوسائط.</string>
  <string name="feature_duck_media_on_record_on_desc">أثناء التسجيل، يطلب التطبيق من التطبيقات الأخرى خفض الصوت مؤقتاً أو الإيقاف لتقليل تداخل الوسائط. النتيجة تعتمد على النظام وتطبيق الوسائط.</string>

  <!-- Offline denoise -->
  <string name="feature_auto_cancel_empty_audio_input_off_desc">تُرسل طلبات التعرّف غير المباشر حتى عند عدم اكتشاف كلام في التسجيل.</string>
  <string name="feature_auto_cancel_empty_audio_input_on_desc">قبل إرسال تسجيل مكتمل، يفحصه التطبيق على جهازك. إن لم يحتوِ كلاماً، يُتجاهل بدل إرساله لمزود التعرّف.</string>
  <string name="feature_auto_filter_silent_audio_segments_off_desc">يستخدم التعرّف غير المباشر التسجيل الأصلي، بما فيه التوقفات الصامتة.</string>
  <string name="feature_auto_filter_silent_audio_segments_on_desc">قبل التعرّف، يزيل التطبيق الأجزاء الصامتة من التسجيل المكتمل على جهازك. يقصّر الصوت وقد يقلّل وقت الرفع.</string>

  <!-- Offline denoise -->
  <string name="feature_offline_denoise_off_desc">يُستخدم الصوت الخام دون إزالة ضوضاء قائمة على نموذج.</string>
  <string name="feature_offline_denoise_on_desc">يطبّق إزالة ضوضاء قائمة على نموذج قبل الرفع غير المباشر أو التعرّف دون اتصال. تحسّن محدود للكلام منخفض الصوت.</string>

  <!-- Upload audio compression -->
  <string name="feature_upload_audio_compression_off_desc">تُرفع التسجيلات المكتملة بصيغتها الأصلية غير المضغوطة. يستخدم الرفع بيانات أكثر، دون ضغط إضافي مسبقاً.</string>
  <string name="feature_upload_audio_compression_on_desc">عند دعم مزود التعرّف، تُضغط التسجيلات المكتملة قبل الرفع. يستخدم بيانات أقل وقد يكون أسرع.</string>

  <!-- Headset mic priority -->
  <string name="feature_headset_mic_priority_off_desc">يستخدم ميكروفون الجهاز المدمج للتسجيل.</string>
  <string name="feature_headset_mic_priority_on_desc">يفضّل ميكروفون السماعة عند توفره. ميزة تجريبية، تتطلّب إذن Bluetooth وإذن الأجهزة القريبة.</string>

