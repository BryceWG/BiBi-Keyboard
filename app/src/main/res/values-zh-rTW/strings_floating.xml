    <!-- ============================================== -->
    <!-- 懸浮球設定 - 功能說明 -->
    <!-- ============================================== -->

    <!-- 使用懸浮球進行語音識別 -->
    <string name="feature_floating_asr_off_desc">不顯示懸浮球，仍可從說點啥鍵盤使用語音輸入。</string>
    <string name="feature_floating_asr_on_desc">在其他應用程式上方顯示語音輸入懸浮球，即使鍵盤未顯示也可開始辨識。需要懸浮窗權限；音量鍵控制與部分文字輸入方式還需要無障礙服務或輸入法橋接。</string>

    <!-- 僅在鍵盤顯示時顯示懸浮球 -->
    <string name="feature_floating_only_when_ime_visible_off_desc">即使鍵盤隱藏，懸浮球仍保持可見。</string>
    <string name="feature_floating_only_when_ime_visible_on_desc">鍵盤隱藏時懸浮球自動隱藏，鍵盤出現時自動顯示。鍵盤狀態可透過無障礙或已啟用的輸入法橋接偵測。</string>

    <!-- 長按懸浮球錄音 -->
    <string name="feature_floating_hold_to_record_off_desc">點按懸浮球開始錄音，再次點按停止錄音。</string>
    <string name="feature_floating_hold_to_record_on_desc">長按懸浮球開始錄音，放開後停止。滑出選單或移動懸浮球需要拖動更長距離，觸發時會取消本次錄音。</string>

    <!-- 直接拖動移動懸浮球 -->
    <string name="feature_floating_direct_drag_off_desc">移動懸浮球需要長按進入移動模式或透過選單開啟移動模式。</string>
    <string name="feature_floating_direct_drag_on_desc">可直接拖動懸浮球調整位置。</string>

    <!-- 音量鍵錄音模式 -->
    <string name="feature_volume_key_recording_off_desc">音量鍵保持系統預設行為，不用於控制錄音。</string>
    <string name="feature_volume_key_recording_on_desc">當鍵盤顯示時，無障礙服務會監聽音量鍵點擊，用於開始或停止語音識別。不監聽不穩定的音量鍵長按。</string>
    <string name="feature_volume_key_status_toast_off_desc">音量鍵錄音開始和停止時不額外提示，現有錯誤提示不受影響。</string>
    <string name="feature_volume_key_status_toast_on_desc">使用音量鍵成功開始或停止錄音時，顯示短 Toast 提示。</string>
    <string name="feature_volume_key_stop_on_ime_hidden_off_desc">音量鍵錄音期間如果鍵盤消失，錄音會繼續，直到你手動停止。</string>
    <string name="feature_volume_key_stop_on_ime_hidden_on_desc">音量鍵錄音期間如果鍵盤消失，會自動停止錄音。</string>

    <!-- 懸浮球寫入文字相容性模式 -->
    <string name="feature_floating_ime_bridge_off_desc">停止接受所有 Hook 聯動請求；主鍵盤與懸浮球的非 Hook 功能不受影響。</string>
    <string name="feature_floating_ime_bridge_on_desc">在用戶端啟用相容 LSPosed/LSPatch 模組提供的輸入法可見性、文字插入、錄音與剪貼簿能力，不影響模組自身設定與狀態。</string>
    <string name="feature_ime_bridge_pcm_recording_off_desc">橋接模組仍可輸入辨識結果，但無法在第三方輸入法中長按錄音。</string>
    <string name="feature_ime_bridge_pcm_recording_on_desc">可在相容的第三方輸入法中長按錄音，並將錄音交給說點啥辨識。錄音失敗時不會自動改用懸浮球或本應用程式的麥克風。</string>
    <string name="feature_floating_a11y_android13_api_off_desc">辨識結果透過傳統無障礙 API 寫入，並保留串流預覽，與相容優化功能配合，適用於一般應用程式和舊系統。</string>
    <string name="feature_floating_a11y_android13_api_on_desc">在 Android 13 及以上優先透過新的無障礙 API 插入辨識結果，在終端機、編輯器等特殊場景有更好的表現。寫入文字相容優化功能自動失效，但會關閉串流預覽功能。</string>
    <string name="feature_floating_write_compat_off_desc">辨識結果會直接寫入輸入框，適用於大多數應用程式。</string>
    <string name="feature_floating_write_compat_on_desc">在你指定的相容應用程式中，會先選取輸入框內容，再透過貼上寫入辨識結果，以避免混入提示文字。期間會暫時使用剪貼簿，完成後會嘗試恢復原內容。</string>

    <!-- 懸浮球識別結果僅寫入剪貼簿 -->
    <string name="feature_floating_write_paste_off_desc">辨識結果會自動輸入到目前的輸入框。</string>
    <string name="feature_floating_write_paste_on_desc">在你指定的應用程式中，辨識結果只會複製到剪貼簿，不會自動輸入；你需要自行貼上。</string>

    <!-- 前台保活 -->
    <string name="feature_floating_keep_alive_off_desc">應用程式在背景執行一段時間後更容易被系統停止，懸浮球與音量鍵功能可能因此失效。</string>
    <string name="feature_floating_keep_alive_on_desc">顯示一則常駐通知，協助懸浮球與音量鍵功能在背景持續可用。部分手機仍需調整電池設定。</string>
    <string name="feature_floating_keep_alive_privileged_off_desc">只使用一般方式維持背景執行，部分手機可能仍會停止懸浮球或音量鍵功能。</string>
    <string name="feature_floating_keep_alive_privileged_on_desc">使用 Shizuku 或 root 定期恢復背景服務，減少懸浮球或音量鍵功能失效。需要先授予 Shizuku 或 root 權限。</string>
</resources>
