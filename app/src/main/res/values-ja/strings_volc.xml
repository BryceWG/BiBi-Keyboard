    <string name="volc_lang_es_mx">スペイン語 (es-MX)</string>
    <string name="volc_lang_pt_br">ポルトガル語 (pt-BR)</string>
    <string name="volc_lang_de_de">ドイツ語 (de-DE)</string>
    <string name="volc_lang_fr_fr">フランス語 (fr-FR)</string>
    <string name="volc_lang_ko_kr">韓国語 (ko-KR)</string>
