<resources>
    <!-- Volcengine (Volcano Engine) ASR 設定文字列 -->
    <string name="volc_section_title">Volcano Engine API設定</string>
    <string name="vendor_volc">Volcano Engine</string>

    <!-- Volc configuration -->
    <string name="label_volc_asr_model">認識モデル</string>
    <string name="volc_asr_model_streaming_v2">Doubaoストリーミング音声認識 2.0</string>
    <string name="volc_asr_model_streaming_v1">Doubaoストリーミング音声認識 1.0</string>
    <string name="volc_asr_model_file_v2">Doubao標準ファイル認識 2.0</string>
    <string name="volc_asr_model_file_v1">Doubao標準ファイル認識 1.0</string>
    <string name="volc_asr_model_file_turbo_v1">Doubao高速ファイル認識 1.0</string>
    <string name="feature_volc_asr_model_desc">Doubaoの認識モデルを直接選べます。ストリーミングモデルは話しながら文字が出て、安定したネットワークが必要です。標準ファイル認識は録音終了後に音声全体をアップロードし、精度が高めです。高速ファイル認識も録音終了後にアップロードしますが、処理はより速いです。通常の認識以外の設定は変わりません。</string>
    <string name="label_volc_streaming">ストリーミング認識</string>
    <string name="label_volc_file_standard">ファイル認識（標準版）を使用</string>
    <string name="label_volc_model_v2">Doubao ASR 2.0モデルを使用</string>
    <string name="label_volc_ddc">セマンティックスムージングを有効化（実験的）</string>
    <string name="label_volc_vad">VADセグメンテーションを有効化（実験的）</string>
    <string name="label_volc_nonstream">2パス認識を有効化（実験的）</string>
    <string name="label_volc_language">認識言語</string>
    <string name="label_volc_use_new_auth">新しい認証方式を使用</string>
    <string name="label_volc_api_key">X-Api-Key</string>

    <!-- Volc modes hint -->
    <string name="volc_modes_hint">Doubaoの認識モデルを直接選べます：\n
1. ストリーミング音声認識 2.0 / 1.0：話しながら文字が出て、開始と終了の遅延が小さくなります。安定したネットワークが必要です。\n
2. 標準ファイル認識 2.0 / 1.0（submit/query）：録音終了後に音声全体をアップロードし、精度が高めです。\n
3. 高速ファイル認識 1.0（flash）：録音終了後にアップロードし、処理はより速いです。</string>

    <!-- Volc language options -->
    <string name="volc_lang_auto">自動（中国語/英語+方言）</string>
    <string name="volc_lang_yue_cn">広東語 (yue-CN)</string>
