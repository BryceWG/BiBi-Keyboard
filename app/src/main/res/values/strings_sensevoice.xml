    <!-- SenseVoice - Use ITN -->
    <string name="feature_sv_use_itn_off_desc">Keeps spoken forms, such as “one thousand two hundred thirty-four”.</string>
    <string name="feature_sv_use_itn_on_desc">Converts supported Chinese numbers, dates, and times to common written forms, such as “1234”.</string>

    <!-- SenseVoice - Preload model -->
    <string name="feature_sv_preload_off_desc">Loads the model only when needed, which may cause delay on first use.</string>
    <string name="feature_sv_preload_on_desc">Preloads the model when the keyboard appears to reduce first-use latency.</string>

    <!-- SenseVoice - Pseudo streaming -->
    <string name="label_sv_pseudo_stream">Enable pseudo streaming preview (fixed-length segments)</string>
    <string name="feature_sv_pseudo_stream_off_desc">Disable pseudo streaming. Audio is recognized once at the end, same as traditional offline mode.</string>
    <string name="feature_sv_pseudo_stream_on_desc">Splits audio into fixed-length segments for local preview, then runs full recognition at the end to overwrite the preview text.</string>
